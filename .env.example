# Public hostname for the server (Caddy gets a TLS cert for it).
# Use your own subdomain (e.g. bot.artreserve.org) or <ip-with-dashes>.sslip.io
DOMAIN=

# AWS credentials for SES (IAM user limited to ses:SendEmail / ses:SendRawEmail)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_FROM_EMAIL=grace@artreserve.org
SES_FROM_NAME=Grace Logan

# ArtStation session cookie used by the scraper
COOKIE=

# Shared secret the Chrome extension must send as wss://DOMAIN/?token=...
# Generate with: openssl rand -hex 24
WS_TOKEN=

# ARN of the SNS topic that SES publishes bounces/complaints to
SNS_TOPIC_ARN=
